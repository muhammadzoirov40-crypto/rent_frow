# RentFlow Environment Configuration
APP_NAME=RentFlow
APP_VERSION=1.0.0
DEBUG=true

DATABASE_URL=postgresql+asyncpg://rentflow:rentflow@localhost:5432/rentflow
DATABASE_URL_SYNC=postgresql+psycopg2://rentflow:rentflow@localhost:5432/rentflow

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-secret-min-32-chars
JWT_ALGORITHM=HS256

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rentflow
S3_REGION=us-east-1

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ORIGINS=["*"]
