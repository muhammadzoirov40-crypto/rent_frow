# RentFlow Environment Configuration
# First run:  cp .env.example .env
# SQLite works out of the box — no PostgreSQL needed for local/server dev.

APP_NAME=RentFlow
APP_VERSION=1.0.0
# DEBUG=true → /auth/send-otp also returns dev_code (the OTP code) so the UI can show it.
DEBUG=true

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./rentflow.db
DATABASE_URL_SYNC=sqlite:///./rentflow.db

# Database (PostgreSQL — used by docker compose, which overrides these values)
# DATABASE_URL=postgresql+asyncpg://rentflow:rentflow@localhost:5432/rentflow
# DATABASE_URL_SYNC=postgresql+psycopg2://rentflow:rentflow@localhost:5432/rentflow

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# SMTP (OTP emails). Leave empty → no email is sent (DEBUG=true still returns dev_code, otherwise an error).
# Gmail: create an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Resend (preferred — better inbox delivery). If set, SMTP is only a fallback.
RESEND_API_KEY=
EMAIL_FROM=RentFlow <no-reply@renthub.qobus.tj>

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Google OAuth (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=1040006931222-39iacj22kk6me8go2vvkrr0bpu845mp4.apps.googleusercontent.com

# Optional infra (only needed for celery/redis/s3 features)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rentflow
S3_REGION=us-east-1

CORS_ORIGINS=["*"]
