  "terms": {
    "title": "Terms of Use",
    "updated": "Last updated: 1 October 2026",
    "intro": "These Terms of Use govern your access to and use of the RentHub platform, including our website and mobile application. By creating an account or using RentHub, you agree to be bound by these Terms.",
    "s1h": "Acceptance of these Terms",
    "s1b": "By registering, accessing, or using RentHub you confirm that you have read, understood, and agree to these Terms. If you do not agree, you may not use the platform.",
    "s2h": "Account and registration",
    "s2b": "You must provide accurate and complete information when creating an account and keep your credentials secure. You are responsible for all activity that occurs under your account. One person or legal entity may not maintain more than one account.",
    "s3h": "Listings and user content",
    "s3b": "Owners are responsible for the accuracy of their listings, including title, description, price, images, and availability. You grant RentHub a non-exclusive licence to display your content on the platform. Content that is misleading, illegal, or infringes third-party rights may be removed.",
    "s4h": "Bookings and payment",
    "s4b": "A booking request becomes binding once the owner accepts it. Prices, deposits, and any additional fees are shown before confirmation. RentHub facilitates payments between renters and owners but is not a party to the rental agreement itself.",
    "s5h": "Prohibited conduct",
    "s5b": "You may not post false listings, manipulate reviews, circumvent fees, harass other users, or use RentHub for any unlawful purpose. We may suspend or terminate accounts that violate these rules.",
    "s6h": "Limitation of liability",
    "s6b": "RentHub provides the platform as is and is not responsible for the condition, legality, or quality of items offered by users, nor for disputes between them. To the maximum extent permitted by law, our liability is limited to the amount of fees paid to us."
  },
  "privacy": {
    "title": "Privacy Policy",
    "updated": "Last updated: 1 October 2026",
    "intro": "This Privacy Policy explains what information RentHub collects, how we use it, and the choices you have. We are committed to protecting your personal data in accordance with applicable data protection law.",
    "s1h": "Information we collect",
    "s1b": "We collect information you provide directly - your name, email address, phone number, profile photo, and content you post - as well as technical data such as device type, IP address, and pages visited.",
    "s2h": "How we use your information",
    "s2b": "We use your data to operate the platform: to create your account, show your listings to other users, process bookings and payments, send service notifications, and improve the reliability and safety of RentHub.",
    "s3h": "Sharing and disclosure",
    "s3b": "Your profile name and listings are public. We never sell your personal data. We share information only with service providers needed to run RentHub, or when required by law.",
    "s4h": "Data security",
    "s4b": "We protect your data with encryption in transit, restricted access, and regular monitoring. No method of transmission is completely secure, but we work to keep your information safe.",
    "s5h": "Your rights",
    "s5b": "You may access, correct, or delete your personal data at any time from your account settings. You may also object to certain processing or request a copy of your data by contacting us.",
    "s6h": "Cookies",
    "s6b": "RentHub uses cookies and local storage to keep you signed in, remember your preferences, and understand how the platform is used. You can control cookies through your browser settings."
  },
