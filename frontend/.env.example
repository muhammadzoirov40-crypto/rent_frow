# Vite dev-proxy target for /api and /uploads.
# Default: http://127.0.0.1:8000 — works both locally and on the server
# (backend runs on the same machine). Override only if the backend is elsewhere.
# If the override is unreachable, Vite automatically falls back to 127.0.0.1:8000.
# VITE_API_URL=http://127.0.0.1:8000
